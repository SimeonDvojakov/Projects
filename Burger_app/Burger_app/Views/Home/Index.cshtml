@{
    ViewData["Title"] = "Home Page";
}


<div class="flex flex-row items-center justify-between px-8">
    <div id="mainText" class="flex w-1/2 flex-col justify-start gap-4">
        <p class="text-4xl text-KetchupRed">Rack'em and stack'em</p>
        <h2 class="text-8xl">Big flavor</h2>
        <h2 class="text-8xl">Stacked your way</h2>
        <p class="text-4xl text-MutedText">Consetetur luptatum sanctus vero sanctus consetetur kasd invidunt ea eum</p>
        <button class="w-max rounded-xl bg-KetchupRed px-5 py-3 text-3xl text-white">Order now</button>
    </div>
    <div id="mainImg" class="flex w-1/2 items-center justify-end">
        <img src="./Assets/burger-placeholder.svg" alt="Burger Placeholder" class="w-9/10"/>
    </div>
</div>


