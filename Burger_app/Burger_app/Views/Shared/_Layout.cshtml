<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Burger_app</title>
    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
    <link rel="stylesheet" href="~/src/output.css" />
    
</head>
<body class="flex min-h-screen flex-col bg-Cream font-bold">
    <header class="sticky top-0">
        <nav class="flex items-center justify-between bg-Char px-8 py-3">
           <h1 class="text-3xl text-MustardYellow">Stack House</h1>
           <div class="flex items-center gap-5 text-xl text-white">
               <a asp-controller="Home" asp-action="Menu">Menu</a>
               <a>My Orders</a>
                <img src="~/Assets/shopping-cart.png" class="h-8" />
               <button class="rounded-xl bg-KetchupRed px-4 py-2">Log In</button>
           </div>
        </nav>
    </header>
        <main class="my-20">
            @RenderBody()
        </main>

    <footer class="sticky bottom-0 mt-auto flex flex-row items-center justify-around bg-MustardYellow px-8 py-3 text-2xl">
        <div class="flex flex-row gap-3">
            <img class="h-8" src="~/Assets/fire-flame.png" alt="Alternate Text" />
            <p>Grilled to order</p>
        </div>
        <div class="flex flex-row gap-3">
            <img class="h-8" src="~/Assets/clock.png"/>
            <p>Ready in 20 minutes</p>
        </div>
        <div class="flex flex-row gap-3">
            <img class="h-8" src="~/Assets/leaves.png"/>
            <p>Fresh local produce</p>
        </div>
    </footer>
@*     <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script> *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
